<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:UltimaMilla.Repartidor.Models"
             xmlns:vm="clr-namespace:UltimaMilla.Repartidor.ViewModels"
             x:DataType="vm:JornadaViewModel"
             x:Class="UltimaMilla.Repartidor.Views.JornadaPage"
             Title="Mi Jornada">

    <Grid Padding="20" RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,*"
          RowSpacing="16" ColumnSpacing="5">

        <!-- Encabezado: saludo al repartidor -->
        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
            <Label Text="{Binding Saludo}" FontSize="24" FontAttributes="Bold" />
            <Label x:Name="FechaLabel" Style="{StaticResource TextoSecundario}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="3">
            <Button Text="Actualizar" Command="{Binding RefrescaParadasCommand}" HorizontalOptions="End" Padding="10,4" />

            <!-- BOTON ALTERNAR TURNO -->
            <Button Text="{Binding TextoBotonTurno}" Command="{Binding AlternarTurnoCommand}" HorizontalOptions="End" Padding="10,4" />

            <!-- RETO 6.2 MUESTRA EL TEMPORIZADOR DEBAJO DEL BOTON-->
            <Label Text="{Binding TiempoTranscurrido}" 
                   HorizontalOptions="End" 
                   TextColor="#60A5FA" 
                   FontSize="13" 
                   FontAttributes="Bold" />

            <ActivityIndicator IsRunning="{Binding IsRefrescando}" IsVisible="{Binding IsRefrescando}" />
            <Label Text="{Binding MensajeEstado}" Style="{StaticResource TextoSecundario}"
                   FontSize="12" HorizontalOptions="End" />
        </VerticalStackLayout>

        <!-- Tarjeta de resumen del día -->
        <!-- RETO N2 Cambiamos las columnas a *,*,*,Auto para que quepan 3 tarjetas y el switch -->
        <Grid Grid.Row="1" Padding="5" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*,Auto">
            
            <!-- 1. Total de entregas -->
            <Border Grid.Row="1" Grid.Column="0" Margin="0,0,4,0" Padding="12" BackgroundColor="#374151" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Total" TextColor="#BDBDBD" FontSize="14" />
                    <Label Text="{Binding TotalEntregas}" TextColor="#60A5FA" FontSize="28" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
            
            <!-- 2. Entregas completadas -->
            <Border Grid.Row="0" Grid.Column="1" Margin="4,0,4,0" Padding="12" BackgroundColor="#374151" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Entregas Completadas" TextColor="#BDBDBD" FontSize="14" />
                    <Label Text="{Binding EntregasCompletadas}" TextColor="#66BB6A" FontSize="28" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <!-- 3. RETO N2: Entregas Pendientes -->
            <Border Grid.Row="0" Grid.Column="2" Margin="4,0,8,0" Padding="12" BackgroundColor="#374151" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Pendientes" TextColor="#BDBDBD" FontSize="14" />
                    <Label Text="{Binding EntregasPendientes}" TextColor="#FF8811" FontSize="28" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
            
            <!-- El Switch -->
            <Switch Grid.Row="0" Grid.Column="3" IsToggled="{Binding SinFiltro, Mode=TwoWay}" HorizontalOptions="End" VerticalOptions="Center">
                <Switch.Triggers>
                    <DataTrigger TargetType="Switch" Binding="{Binding IsRefrescando}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Switch.Triggers>
            </Switch>
        </Grid>
        <!-- El listado: toda la fila 2, las dos columnas -->
        <CollectionView Grid.Row="2" Grid.ColumnSpan="2"
                        ItemsSource="{Binding Paradas}"
                        SelectedItem="{Binding ParadaSeleccionada}" SelectionMode="Single">

            <CollectionView.EmptyView>
                <Label Text="No tienes paradas hoy"
                       FontSize="18" TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Parada">
                    <Border Padding="14" Margin="0,4" StrokeShape="RoundRectangle 10"
                            Stroke="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray400}}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                            <!-- Toque en toda la fila: navega al detalle -->
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnParadaTapped" />
                            </Grid.GestureRecognizers>

                            <Border Grid.Column="0" BackgroundColor="#1C7293"
                                    WidthRequest="34" HeightRequest="34" StrokeShape="RoundRectangle 17">
                                <Label Text="{Binding Numero}" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Cliente}" FontSize="16" FontAttributes="Bold" />
                                <Label Text="{Binding Direccion}" FontSize="12" TextColor="Gray" />
                                <!-- NUEVA ETIQUETA PARA LA DISTANCIA -->
                                <Label Text="{Binding DistanciaTexto}" FontSize="13" TextColor="#60A5FA" FontAttributes="Bold" />
                            </VerticalStackLayout>

                            <!-- ETIQUETA DE ESTADO ACTUALIZADA CON CONVERTIDORES -->
                            <Label Grid.Column="2" 
                                   Text="{Binding Estado, Converter={StaticResource EstadoADisplay}}"
                                   TextColor="{Binding Estado, Converter={StaticResource EstadoAColor}}"
                                   FontSize="14" 
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>