<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UltimaMilla.Repartidor.Views.LoginPage"
             Title="LoginPage">
    <CollectionView ItemsSource="{Binding Repartidores}"
                SelectionMode="Single"
                SelectionChanged="OnRepartidorSeleccionado">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Label Text="{Binding Nombre}" Padding="12" FontSize="18" />
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>